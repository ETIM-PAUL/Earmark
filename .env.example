# Copy to .env and fill in locally. Real values live in the secrets manager;
# never commit keys. Dedicated low-value mainnet accounts only.
# Check everything with: pnpm check:accounts

# Service ports
ORDERS_PORT=4001
BILLERS_PORT=4002
BOT_PORT=4003

# NEAR mainnet accounts (NEAR Intents has no testnet)
NEAR_NETWORK=mainnet
NEAR_RPC_URL=https://rpc.mainnet.fastnear.com
SERVICE_ACCOUNT_ID=
SETTLEMENT_ACCOUNT_ID=
PAYOUT_ACCOUNT_ID=
# Set after the Phase 7 deploy
RECEIPTS_CONTRACT_ID=
# Secrets manager only; never in this file on a shared machine
SERVICE_ACCOUNT_PRIVATE_KEY=

# NEAR Intents Agent API, demo deployment (still mainnet, real funds).
# Key from https://partners.demo.agentsonintents.com/dashboard; it only works
# against the demo URL below. Docs: https://docs.agentsonintents.com/integration/agent-api/overview
NEAR_INTENTS_AGENT_API_KEY=
NEAR_INTENTS_AGENT_API_URL=https://api.demo.agentsonintents.com

# Dedicated low-value NEAR owner for the Agent API spike and dev tests ONLY.
# Real senders sign in their own wallet; Earmark never holds their keys.
DEV_OWNER_ACCOUNT_ID=
DEV_OWNER_PRIVATE_KEY=

# NEAR Intents 1Click. JWT optional: without it a 0.2% fee applies.
ONECLICK_API_URL=https://1click.chaindefuser.com
ONECLICK_JWT=

# VTpass: sandbox keys from https://sandbox.vtpass.com/account
# Switch to https://vtpass.com/api once live access is granted.
VTPASS_BASE_URL=https://sandbox.vtpass.com/api
VTPASS_API_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_SECRET_KEY=
# Our margin on the NGN/USD rate (basis points) and the VTpass wallet floor
# below which new orders stop (naira)
QUOTE_SPREAD_BPS=150
VTPASS_FLOAT_FLOOR_NGN=50000

# NEAR AI Cloud (OpenAI-compatible): key from https://cloud.near.ai
NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_MODEL=deepseek/deepseek-v4.1-flash

# Telegram: token from @BotFather
TELEGRAM_BOT_TOKEN=

# Twilio WhatsApp sandbox until business verification lands
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Public https URL Twilio posts WhatsApp messages to (e.g. an ngrok tunnel
# to BOT_PORT). Needed to check Twilio's signatures; Telegram doesn't need it.
BOT_PUBLIC_URL=
# Where the web app is served; receipt links and the judge view point here
WEB_APP_URL=http://localhost:5173
# Telegram chat ID that gets alerts (low float, stuck orders, missing
# receipts, bot errors). Message the bot first so it may write to you.
ALERTS_TELEGRAM_CHAT_ID=
# Sender app (apps/sender-web): where the bot's /api lives. Default http://localhost:4003
# VITE_API_URL=http://localhost:4003

# Hosts without .earmark/ (Render): the testnet receipts contract and its
# writer, copied from .earmark/receipts-testnet.json. Locally, leave empty.
RECEIPTS_TESTNET_CONTRACT_ID=
RECEIPTS_TESTNET_SERVICE_ACCOUNT_ID=
RECEIPTS_TESTNET_SERVICE_PRIVATE_KEY=

# The family vault on NEAR testnet, from pnpm deploy:vault:testnet (the two
# keys are in .earmark/vault-testnet.json). Set all six and the bot pays
# settlement through the vault in test USDC; leave empty to simulate it.
VAULT_TESTNET_CONTRACT_ID=
VAULT_TESTNET_TOKEN_ID=
VAULT_TESTNET_AGENT_ACCOUNT_ID=
VAULT_TESTNET_AGENT_PAY_KEY=
VAULT_TESTNET_ADMIN_ACCOUNT_ID=
VAULT_TESTNET_ADMIN_KEY=
