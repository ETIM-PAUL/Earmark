# Copy to .env and fill in locally. Real values live in the secrets manager;
# never commit keys. Dedicated low-value mainnet accounts only.

# Service ports
ORDERS_PORT=4001
BILLERS_PORT=4002
BOT_PORT=4003

# NEAR
NEAR_NETWORK=mainnet
RECEIPTS_CONTRACT_ID=
SETTLEMENT_ACCOUNT_ID=
SERVICE_ACCOUNT_ID=
SERVICE_ACCOUNT_PRIVATE_KEY=

# NEAR Intents Agent API (Phase 4)
AGENT_API_PARTNER_KEY=

# NEAR Intents 1Click (Phase 5). Optional: without it a 0.2% fee applies.
ONECLICK_JWT=

# VTpass (Phase 6). Use the sandbox until live access is granted.
VTPASS_BASE_URL=https://sandbox.vtpass.com/api
VTPASS_API_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_SECRET_KEY=

# NEAR AI Cloud, OpenAI-compatible (Phase 10)
NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=

# Messaging (Phase 10)
TELEGRAM_BOT_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
