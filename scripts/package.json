{
  "name": "@earmark/scripts",
  "version": "0.1.0",
  "private": true,
  "description": "Operational scripts: account and key smoke checks, integration spikes",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check:accounts": "tsx src/check-accounts.ts",
    "spike:agent-api": "tsx src/spike/agent-api.ts",
    "setup:agent-production": "tsx src/setup/agent-production.ts",
    "spike:vtpass": "tsx src/spike/vtpass.ts",
    "deploy:receipts:testnet": "tsx src/deploy-receipts.ts",
    "drill:billers": "tsx src/drill/billers.ts",
    "eval:bot": "tsx src/eval/bot.ts",
    "drill:recipient": "tsx src/drill/recipient.ts",
    "drill:attacks": "tsx src/drill/attacks.ts",
    "audit:receipts": "tsx src/audit-receipts.ts",
    "audit:secrets": "tsx src/audit-secrets.ts"
  },
  "dependencies": {
    "@earmark/agent-api": "workspace:*",
    "@earmark/billers": "workspace:*",
    "@earmark/config": "workspace:*",
    "@earmark/shared": "workspace:*",
    "@near-intents-agent-api/sdk": "0.7.3",
    "near-api-js": "7.4.0",
    "@earmark/bot": "workspace:*"
  },
  "devDependencies": {
    "tsx": "4.23.15"
  }
}
