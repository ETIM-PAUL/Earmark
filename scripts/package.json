{
  "name": "@earmark/scripts",
  "version": "0.1.0",
  "private": true,
  "description": "Operational scripts: account and key smoke checks, integration spikes",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
