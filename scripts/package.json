    "@earmark/config": "workspace:*",
    "@earmark/shared": "workspace:*",
    "@near-intents-agent-api/sdk": "0.7.3",
    "near-api-js": "7.4.0"
  },
  "devDependencies": {
    "tsx": "4.23.15"
  }
}
