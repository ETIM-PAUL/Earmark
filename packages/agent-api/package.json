{
  "name": "@earmark/agent-api",
  "version": "0.1.0",
  "private": true,
  "description": "Earmark's integration with the NEAR Intents Agent API: policies, owner signing, flows and refusal messages. Backend only.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@earmark/shared": "workspace:*",
    "@near-intents-agent-api/sdk": "0.7.3",
    "near-api-js": "7.4.0"
  }
}
