{
  "name": "@earmark/sender-web",
  "version": "0.1.0",
  "private": true,
  "description": "Sender web app: rules, top-ups, receipts feed and approvals",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
