{
  "name": "@earmark/bot",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram and WhatsApp assistant on NEAR AI Cloud",
  "type": "module",
  "main": "./dist/lib.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "start:local": "node dist/local.js",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@earmark/agent-api": "workspace:*",
    "@earmark/billers": "workspace:*",
    "@earmark/config": "workspace:*",
    "@earmark/shared": "workspace:*",
    "@near-intents-agent-api/sdk": "0.7.3",
    "@simplewebauthn/server": "14.0.3",
    "near-api-js": "7.4.0",
    "zod": "4.6.7"
  },
  "types": "./dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "default": "./dist/lib.js"
    }
  }
}
